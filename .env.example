# Option A: single backend URL (preferred)
BACKEND_URL=http://localhost:8080/regel/rtf-manuell

# Option B: old env vars — still supported as a fallback if BACKEND_URL is not set
# BE_RTF_MANUELL_URL=http://localhost:8080
# BE_RULE_PATH=regel/rtf-manuell

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3030
